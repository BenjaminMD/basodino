\str_new:N \l__agl_ext_str
\str_new:N \l__agl_stem_str
\str_new:N \l__agl_file_str
\bool_new:N \l__agl_table_bool
\box_new:N \l__agl_map_box
\box_new:N \l__agl_legend_box
\box_new:N \l__agl_top_box
\box_new:N \l__agl_credits_box
\box_new:N \l__agl_block_box
