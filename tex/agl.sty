% Placeholder for missing images, at the requested size.
\msg_new:nnn { agl } { missing-file }
  { File~`#1'~not~found;~drawing~a~#2~mm~placeholder. }
\dim_new:N \l__agl_wd_dim
\dim_new:N \l__agl_ht_dim
\bool_new:N \l__agl_found_bool
\keys_define:nn { agl / placeholder }
  {
    width   .dim_set:N = \l__agl_wd_dim ,
    height  .dim_set:N = \l__agl_ht_dim ,
    unknown .code:n    = { } ,
  }
\cs_new_protected:Npn \__agl_find:n #1
  {
    \bool_set_false:N \l__agl_found_bool
    \file_if_exist:nTF {#1}
      { \bool_set_true:N \l__agl_found_bool }
      {
        \clist_map_inline:nn { .pdf , .png , .jpg , .jpeg }
          { \file_if_exist:nT { #1 ##1 } { \bool_set_true:N \l__agl_found_bool \clist_map_break: } }
      }
  }
\cs_new:Npn \__agl_mm:N #1 { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn {#1} { 1 mm } ) } }
\cs_new_protected:Npn \__agl_placeholder:nn #1#2
  {
    \group_begin:
      \dim_set:Nn \l__agl_wd_dim { \linewidth }
      \dim_zero:N \l__agl_ht_dim
      \keys_set:nn { agl / placeholder } {#1}
      \dim_compare:nNnT { \l__agl_ht_dim } = { \c_zero_dim }
        { \dim_set:Nn \l__agl_ht_dim { 0.618 \l__agl_wd_dim } }
      \msg_warning:nnee { agl } { missing-file } {#2}
        { \__agl_mm:N \l__agl_wd_dim \c_space_tl x \c_space_tl \__agl_mm:N \l__agl_ht_dim }
      \agl@drawplaceholder { \l__agl_wd_dim } { \l__agl_ht_dim } {#2}
        { \__agl_mm:N \l__agl_wd_dim \,\texttimes\, \__agl_mm:N \l__agl_ht_dim \,mm }
    \group_end:
  }
\NewCommandCopy \__agl_includegraphics:w \includegraphics
\RenewDocumentCommand \includegraphics { s O{} m }
  {
    \__agl_find:n {#3}
    \bool_if:NTF \l__agl_found_bool
      {
        \IfBooleanTF {#1}
          { \__agl_includegraphics:w * [#2] {#3} }
          { \__agl_includegraphics:w [#2] {#3} }
      }
      { \__agl_placeholder:nn {#2} {#3} }
  }
