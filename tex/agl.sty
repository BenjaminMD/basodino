\ihead*{Applied Glaciology -- Assignments part~1}
\ohead*{\headmark}
% Footer parts sit on one baseline, text bottom + \footskip; a long list of
% names wraps upwards instead of running into the page number. (The foot
% layer hangs from its top edge, which lies at text bottom + \footskip +
% strut depth - \footheight; that strut is the normal-size one of the
% output routine, not the footer's.)
\newlength\agl@footdp
\AtBeginDocument{\setlength\agl@footdp{\dp\strutbox}}
\newcommand\agl@foot[1]{\vbox to \dimexpr\footheight-\agl@footdp\relax{\vfill\hbox{#1\strut}}}
\ifoot*{\agl@foot{\parbox[b]{\dimexpr\textwidth-30mm\relax}{\raggedright\color{ink}\agl@nameline}}}
\ofoot*{\agl@foot{Page \thepage\ of \PreviousTotalPages}}
% bare: the same foot, no head and no head rule (title page, picture pages)
\newpairofpagestyles{bare}{%
  \ifoot*{\agl@foot{\parbox[b]{\dimexpr\textwidth-30mm\relax}{\raggedright\color{ink}\agl@nameline}}}%
  \ofoot*{\agl@foot{Page \thepage\ of \PreviousTotalPages}}}
\setkomafont{pageheadfoot}{\sffamily\footnotesize\color{rock}}
\setkomafont{pagenumber}{}
\setkomafont{headsepline}{\color{rule}}
\pagestyle{scrheadings}
% plate pages: group names in the header, the page number alone in the footer
\newpairofpagestyles[scrheadings]{plate}{%
