\msg_new:nnn { agl } { missing-caption }
  { Caption~file~`#1'~not~found;~the~page~shows~a~placeholder. }
\msg_new:nnn { agl } { plate-map }
  { Plate~map~`#1'~is~#2~mm,~not~175~x~175~mm;~placed~at~100~\c_percent_str. }
\msg_new:nnn { agl } { plate-legend }
  {
    Plate~legend~`#1'~is~#2~mm,~not~92~mm~wide~and~at~most~105~mm~high;~
    placed~at~100~\c_percent_str.
  }
\msg_new:nnn { agl } { plate-sidebar }
