% agl.sty -- house style for "Applied Glaciology -- Assignments part 1"
% (Ghiacciaio del Basòdino, ETH Zürich, Fall Semester 2026).
%
% main.tex holds content only; every layout, font, colour and environment
% decision lives here. Engine: LuaLaTeX (fontspec, piton, page-size switch
% for landscape plates). Build: latexmk (see .latexmkrc).
%
% Interface used in main.tex
%   \groupmembers{Name One, Name Two, ...}   names on every page and the title page
%   \title \subtitle \date                   title page
%   \herofigure{file}{caption}{credit}       title-page image, 210 x 88 mm, full bleed
%   \begin{question}{3.1}{7} ... \end{question}           "Question 3.1 [7 pts]" box
%   \plate{plate1_tour}                      landscape plate page from <id>_map.pdf,
%                                            <id>_legend.pdf and the sidecar text
%   \atlasfig{elevation_glacier}             atlas figure, one or two per page
%   \sidecarfigure[pos]{dir/stem}            floating figure with sidecar text
%   \platedir{dir} \atlasdir{dir}            where plates and atlas figures are
%                                            (sidecar files: see SIDECARS.md)
%   \plateversion{atlas}                     plates from <id>_map_atlas.pdf and
%                                            <id>_legend_atlas.pdf where present
%   \credit{Data: \textcopyright\,swisstopo}  source line under a figure or table
%   \codefile{path}                          Python listing (placeholder if missing)
%   \placeholder{text}                       unfinished text: grey, counted in the log
%   units inside \qty/\unit: \mwe \mwea \ddf \kmcubed \masl \we \annum
%   colours: glacier water ice rock accent text rule ink (palette of the maps)
% Missing image files never stop the build: \includegraphics draws a
% placeholder of the requested size and logs a warning with the size in mm.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{agl}[2026/09/30 Applied Glaciology report style]
\RequirePackage{iftex}
\RequireLuaTeX

% ------------------------------------------------------------------ layout
% Text pages: A4 portrait, 30 mm left and right, 25 mm top, 30 mm bottom;
% header rule 17 mm and footer baseline 16 mm from the edges. Text block
% 150 x 242 mm (about 87 characters per line in 11 pt Source Serif 4).
% Plate pages: A4 landscape, a real 297 x 210 mm page. The text block is
% the plate area, 273 x 175 mm: 12 mm side margins, a 20 mm header zone
% (course and group names, rule 14 mm from the top edge) and a 15 mm
% footer zone (page number, baseline 9 mm from the bottom edge).
\KOMAoptions{fontsize=11pt, parskip=false, numbers=noendperiod}
\linespread{1.05}
\newcommand*\agl@layout[6]{% paper, text width, text height, text top, \headsep, \footskip
  \KOMAoptions{paper=#1}\areaset{#2}{#3}%
  % \areaset leaves 1/3 of the free height above the text: move the text
  % top to #4 and keep it there while \headsep changes.
  \addtolength\topmargin{\dimexpr #4-(\paperheight-\textheight)/3+\headsep-#5\relax}%
  \setlength\headsep{#5}%
  \setlength\footskip{#6}%
  \setlength\footheight{2.2\baselineskip}}% room for names on two lines
\newcommand*\agl@portrait{\agl@layout{portrait}{150mm}{242mm}{25mm}{8mm}{14mm}}
\newcommand*\agl@platelayout{\agl@layout{landscape}{273mm}{175mm}{20mm}{6mm}{6mm}}
\agl@portrait

% ------------------------------------------------------------------- fonts
\RequirePackage{fontspec}
\RequirePackage{amsmath}
\RequirePackage{unicode-math}
\setmainfont{SourceSerif4}[
  Extension = .otf, UprightFont = *-Regular, ItalicFont = *-RegularIt,
  BoldFont = *-Semibold, BoldItalicFont = *-SemiboldIt,
  Numbers = Proportional]
\setsansfont{SourceSans3}[
  Extension = .otf, UprightFont = *-Regular, ItalicFont = *-RegularIt,
  BoldFont = *-Semibold, BoldItalicFont = *-SemiboldIt,
  FontFace = {l}{n}{*-Light},
  Numbers = Proportional]
\setmonofont{SourceCodePro}[
  Extension = .otf, UprightFont = *-Regular, ItalicFont = *-RegularIt,
  BoldFont = *-Semibold, BoldItalicFont = *-SemiboldIt,
  Scale = MatchLowercase]
% Math font: STIX Two Math, chosen against Libertinus Math in test/mathfont.tex.
%  - x-height 473/1000 against 475/1000 for Source Serif 4. Libertinus Math has
%    429: its letters look 10 % small next to the text, and scaling it up
%    (Scale=MatchLowercase) makes its capitals 10 % too tall instead.
%  - STIX Two is a transitional face with the stroke weight and contrast of
%    Source Serif 4; Libertinus is lighter and more calligraphic beside it.
% Digits in formulas come from Source Serif 4, so 850 reads the same in text,
% tables and equations.
\setmathfont{STIXTwoMath-Regular.otf}
\setmathfont{SourceSerif4-Regular.otf}[range=up/{num,latin,Latin}]% digits and upright letters as in the text
\setmathfont{SourceSerif4-RegularIt.otf}[range=it/{latin,Latin}]% variables in the text italic; Greek and symbols stay STIX

% ------------------------------------------------------------------ colour
% One palette for report and maps: report_palette in ../maps/style.json,
% copied 2026-09-30. Change it there, then here. Contrast on white in
% brackets.
\RequirePackage{xcolor}
\definecolor{glacier}{HTML}{027ABE}% blue ink of glacier names: headings, links, labels (4.6:1)
\definecolor{water}{HTML}{027ABE}% same blue: water, code strings (4.6:1)
\definecolor{ice}{HTML}{DCEBF4}% flat tone of the glacier relief: box backgrounds
\definecolor{rock}{HTML}{4D4D4D}% grid-label grey: secondary text, header, footer (8.5:1)
\definecolor{accent}{HTML}{C51415}% mountain-trail red: routes, markers, highlights (6.0:1)
\definecolor{text}{HTML}{1A1A1A}% body text (17.4:1)
\definecolor{rule}{HTML}{B3B3B3}% legend-rule grey: rules and frames
\colorlet{ink}{glacier!30!black}% title and heading text (15.8:1)
\color{text}% the normal colour of the document

