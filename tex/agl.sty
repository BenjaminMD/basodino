    shorten~\iow_char:N\\FigText~or~the~legend.
  }
\msg_new:nnn { agl } { plate-room }
  { Plate~#1:~legend~#2~mm~high,~#3~mm~of~the~sidebar~left~free. }
\msg_new:nnn { agl } { plate-version }
