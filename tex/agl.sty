\msg_new:nnn { agl } { atlas-height }
  { Atlas~figure~`#1'~with~its~caption~is~#2~mm~high,~more~than~a~page~(#3~mm). }
\cs_generate_variant:Nn \msg_warning:nnnnn { nneee }
\cs_generate_variant:Nn \msg_warning:nnnnnn { nneeee }
\cs_generate_variant:Nn \msg_info:nnnnn { nneee }
% "W x H" of a box in mm, one decimal
\cs_new:Npn \__agl_size:N #1
  {
    \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \box_wd:N #1 } { 1 mm } , 1 ) }
    \c_space_tl x \c_space_tl
    \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \box_ht:N #1 + \box_dp:N #1 } { 1 mm } , 1 ) }
  }
% Directory and name of a sidecar set: #2 as given if it has a directory,
% else in directory #1.
\cs_new_protected:Npn \__agl_stem:Nn #1#2
  {
    \file_parse_full_name:nNNN {#2} \l__agl_dir_str \l__agl_name_str \l__agl_ext_str
    \str_put_right:NV \l__agl_name_str \l__agl_ext_str
    \str_if_empty:NT \l__agl_dir_str { \str_set_eq:NN \l__agl_dir_str #1 }
    \str_set:Ne \l__agl_stem_str { \l__agl_dir_str / \l__agl_name_str }
  }
% Read <stem>.caption.tex (placeholder text if missing); note a table file.
\cs_new_protected:Npn \__agl_sidecar:
  {
    \cs_set:Npn \FigTitle { }
    \cs_set:Npn \FigText { }
    \cs_set:Npn \FigCredits { }
    \file_if_exist:nTF { \l__agl_stem_str .caption.tex }
      { \file_input:n { \l__agl_stem_str .caption.tex } }
      {
        \msg_warning:nne { agl } { missing-caption } { \l__agl_stem_str .caption.tex }
        \cs_set:Npn \FigTitle { Caption~missing }
        \cs_set:Npe \FigText
          {
            \exp_not:N \placeholder
              { Title,~text~and~credits~come~from~\l__agl_name_str .caption.tex. }
          }
      }
    \file_if_exist:nTF { \l__agl_stem_str .table.tex }
      { \bool_set_true:N \l__agl_table_bool }
      { \bool_set_false:N \l__agl_table_bool }
  }
% The table, 92 mm wide, indented by #1.
\cs_new_protected:Npn \__agl_table:n #1
  {
    \bool_if:NT \l__agl_table_bool
      {
        \par \addvspace { 4mm }
        \group_begin:
          \agl@rag
          \agl@tablefont
          \noindent \skip_horizontal:n {#1}
          \begin{minipage}[t]{\c__agl_side_dim}
            \file_input:n { \l__agl_stem_str .table.tex }
          \end{minipage}
          \par
        \group_end:
      }
  }
% A graphic at natural size into box #1; a missing one as a placeholder of
% width #3 and height #4.
\cs_new_protected:Npn \__agl_graphic:Nnnn #1#2#3#4
  {
    \__agl_find:n {#2}
    \bool_if:NTF \l__agl_found_bool
      { \hbox_set:Nn #1 { \__agl_includegraphics:w {#2} } }
      { \hbox_set:Nn #1 { \__agl_placeholder:nn { width = #3 , height = #4 } {#2} } }
  }
\cs_generate_variant:Nn \__agl_graphic:Nnnn { NV }
\cs_generate_variant:Nn \regex_extract_once:nnNTF { nV }
% File name of a plate graphic, #1 = map or legend: <stem>_#1, or
% <stem>_#1_<version> if \plateversion is set and that file exists.
\cs_new_protected:Npn \__agl_platefile:n #1
  {
    \str_set:Ne \l__agl_file_str { \l__agl_stem_str _ #1 }
    \str_if_empty:NF \g__agl_version_str
      {
        \exp_args:Ne \__agl_find:n { \l__agl_file_str _ \g__agl_version_str }
        \bool_if:NTF \l__agl_found_bool
          { \str_put_right:Ne \l__agl_file_str { _ \g__agl_version_str } }
          { \msg_info:nnee { agl } { plate-version } { \l__agl_file_str } { \g__agl_version_str } }
      }
  }
% --- plate page
\NewDocumentCommand \plate { m }
  {
    \clearpage
    \agl@platelayout
    \group_begin:
      \thispagestyle { plate }
      \__agl_stem:Nn \g__agl_platedir_str {#1}
      \__agl_sidecar:
      \regex_extract_once:nVNTF { plate(\d+[a-z]?) } \l__agl_name_str \l__agl_match_seq
        { \tl_set:Ne \l__agl_number_tl { \seq_item:Nn \l__agl_match_seq { 2 } } }
        { \tl_set:Ne \l__agl_number_tl { \int_eval:n { \value { plate } + 1 } } }
      \cs_set:Npe \theplate { \l__agl_number_tl }
      \cs_set_eq:NN \theHplate \theplate
      \refstepcounter { plate }
      \tl_set:No \@currentlabelname { \FigTitle }
      \exp_args:NV \label \l__agl_name_str
      \addcontentsline { lof } { plate } { \protect \numberline { \theplate } \FigTitle }
      \__agl_plate_map:
      \__agl_plate_sidebar:
      \nointerlineskip
      \hbox_to_wd:nn { \textwidth }
        {
          \box_use_drop:N \l__agl_map_box
          \skip_horizontal:N \c__agl_gutter_dim
          \box_use_drop:N \l__agl_top_box
          \tex_hss:D
        }
    \group_end:
    \clearpage
    \agl@portrait
