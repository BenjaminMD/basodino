\ExplSyntaxOn
\clist_new:N \g__agl_members_clist
\NewDocumentCommand \groupmembers { m } { \clist_gset:Nn \g__agl_members_clist {#1} }
\cs_new:Npn \agl@names #1 { \clist_use:Nn \g__agl_members_clist {#1} }
\cs_new_protected:Npn \agl@namelist { \clist_map_inline:Nn \g__agl_members_clist { ##1 \par } }
% names on one line: never split, lines break only after a separator dot
\cs_new_protected:Npn \agl@nameline
  {
    \seq_set_from_clist:NN \l_tmpa_seq \g__agl_members_clist
    \seq_set_map:NNn \l_tmpa_seq \l_tmpa_seq { \mbox{##1} }
    \seq_use:Nn \l_tmpa_seq { \nobreak\enskip\textperiodcentered\enskip }
  }
