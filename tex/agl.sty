% The map in a frame of exactly 175 x 175 mm: a file of another size is
% reported and sticks out, the sidebar stays in place.
\cs_new_protected:Npn \__agl_plate_map:
  {
    \__agl_platefile:n { map }
    \__agl_graphic:NVnn \l__agl_map_box \l__agl_file_str { 175mm } { 175mm }
    \bool_lazy_and:nnT { \l__agl_found_bool }
      {
        \bool_lazy_or_p:nn
          { \dim_compare_p:n { \dim_abs:n { \box_wd:N \l__agl_map_box - \c__agl_map_dim } > 0.1mm } }
          {
            \dim_compare_p:n
              { \dim_abs:n { \box_ht:N \l__agl_map_box + \box_dp:N \l__agl_map_box - \c__agl_map_dim } > 0.1mm }
          }
      }
      { \msg_warning:nnee { agl } { plate-map } { \l__agl_file_str } { \__agl_size:N \l__agl_map_box } }
    \hbox_set_to_wd:Nnn \l__agl_map_box { \c__agl_map_dim }
      {
        \vbox_to_ht:nn { \c__agl_map_dim } { \box_use_drop:N \l__agl_map_box \tex_vss:D }
        \tex_hss:D
      }
  }
% Sidebar: legend, heading, text and table in one box, credits in another;
% together exactly as high as the map, credits at the foot. Too much
% content is reported and hangs below the map.
\cs_new_protected:Npn \__agl_plate_sidebar:
  {
    \__agl_platefile:n { legend }
    \__agl_graphic:NVnn \l__agl_legend_box \l__agl_file_str { 92mm } { 60mm }
    \bool_lazy_and:nnT { \l__agl_found_bool }
      {
        \bool_lazy_or_p:nn
          { \dim_compare_p:n { \dim_abs:n { \box_wd:N \l__agl_legend_box - \c__agl_side_dim } > 0.1mm } }
          {
            \dim_compare_p:n
              { \box_ht:N \l__agl_legend_box + \box_dp:N \l__agl_legend_box > \c__agl_legend_dim + 0.1mm }
          }
      }
      { \msg_warning:nnee { agl } { plate-legend } { \l__agl_file_str } { \__agl_size:N \l__agl_legend_box } }
    \dim_set:Nn \l__agl_legend_dim { \box_ht:N \l__agl_legend_box + \box_dp:N \l__agl_legend_box }
    \vbox_set:Nn \l__agl_top_box
      {
        \dim_set_eq:NN \hsize \c__agl_side_dim
        \dim_set_eq:NN \linewidth \hsize
        \box_use_drop:N \l__agl_legend_box
        \nointerlineskip
        \skip_vertical:N \c__agl_legendgap_dim
        \dim_zero:N \parindent
        \agl@platehead
        \agl@platetext
        \__agl_table:n { 0pt }
      }
    \vbox_set:Nn \l__agl_credits_box
      {
        \dim_set_eq:NN \hsize \c__agl_side_dim
        \agl@credits
      }
    \dim_set:Nn \l__agl_excess_dim
      {
        \box_ht:N \l__agl_top_box + \box_dp:N \l__agl_top_box + \c__agl_creditgap_dim
        + \box_ht:N \l__agl_credits_box - \c__agl_map_dim
      }
    \dim_compare:nNnTF { \l__agl_excess_dim } > { 0pt }
      {
        \msg_warning:nneee { agl } { plate-sidebar } { \theplate }
          { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \l__agl_excess_dim } { 1 mm } , 1 ) } }
          { \fp_eval:n { ceil ( \dim_to_decimal_in_unit:nn { \l__agl_excess_dim } { 1 mm } / 4.45 ) } }
        \vbox_set_to_ht:Nnn \l__agl_top_box { \c__agl_map_dim }
          {
            \box_use_drop:N \l__agl_top_box
            \skip_vertical:N \c__agl_creditgap_dim
            \box_use_drop:N \l__agl_credits_box
            \tex_vss:D
          }
      }
      {
        \msg_info:nneee { agl } { plate-room } { \theplate }
          { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \l__agl_legend_dim } { 1 mm } , 1 ) } }
          { \fp_eval:n { round ( - \dim_to_decimal_in_unit:nn { \l__agl_excess_dim } { 1 mm } , 1 ) } }
        \vbox_set_to_ht:Nnn \l__agl_top_box { \c__agl_map_dim }
          {
            \box_use_drop:N \l__agl_top_box
            \skip_vertical:n { \c__agl_creditgap_dim plus 1fill }
            \box_use_drop:N \l__agl_credits_box
          }
      }
  }
% --- atlas and text figures: graphic at text width, then the caption
% ("Figure A.1  Title. Text"), with credits and table aligned with its text.
% A graphic of another width is scaled to the text width.
\dim_new:N \l__agl_indent_dim
\cs_new_protected:Npn \__agl_figure:
  {
    \captionsetup { type = figure }% links to the figure land on its top edge
    \__agl_graphic:NVnn \l__agl_map_box \l__agl_stem_str { \linewidth } { \linewidth }
    \bool_if:NT \l__agl_found_bool
      {
        \dim_compare:nNnT { \dim_abs:n { \box_wd:N \l__agl_map_box - \linewidth } } > { 0.1mm }
          {
            \msg_warning:nneeee { agl } { figure-width } { \l__agl_stem_str }
              { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \box_wd:N \l__agl_map_box } { 1 mm } , 1 ) } }
              { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \linewidth } { 1 mm } , 1 ) } }
              { \fp_eval:n { round ( 100 * \linewidth / \box_wd:N \l__agl_map_box ) } }
            \hbox_set:Nn \l__agl_map_box
              { \__agl_includegraphics:w [ width = \linewidth ] { \l__agl_stem_str } }
          }
      }
    \par \noindent \box_use_drop:N \l__agl_map_box \par
    \tl_set:No \l__agl_title_tl { \FigTitle }
    \use:e { \exp_not:N \caption [ { \exp_not:V \l__agl_title_tl } ] }
      { { \bfseries \color { ink } \FigTitle . } \enskip \FigText }
    \exp_args:NV \label \l__agl_name_str
    % the hanging indent of the caption: label and separator (caption: format=hang)
    \hbox_set:Nn \l_tmpa_box { \sffamily \small \bfseries \figurename \nobreakspace \thefigure \quad }
    \dim_set:Nn \l__agl_indent_dim { \box_wd:N \l_tmpa_box }
    \tl_if_empty:oF { \FigCredits }
      {
        \par \skip_vertical:n { 1mm }
        \group_begin:
          \agl@rag
          \dim_set_eq:NN \leftskip \l__agl_indent_dim
          \sffamily \scriptsize \color { rock } \FigCredits \par
        \group_end:
      }
    \__agl_table:n { \l__agl_indent_dim }
  }
\NewDocumentCommand \atlasfig { m }
  {
    \par
    \group_begin:
      \__agl_stem:Nn \g__agl_atlasdir_str {#1}
      \__agl_sidecar:
      \vbox_set:Nn \l__agl_block_box
        {
          \dim_set_eq:NN \hsize \textwidth
          \dim_set_eq:NN \linewidth \textwidth
          \__agl_figure:
        }
      \dim_compare:nNnTF
        { \box_ht:N \l__agl_block_box + \box_dp:N \l__agl_block_box }
        > { ( \textheight - \c__agl_atlasgap_dim ) / 2 }
        {
          \dim_compare:nNnT
            { \box_ht:N \l__agl_block_box + \box_dp:N \l__agl_block_box } > { \textheight }
            {
              \msg_warning:nneee { agl } { atlas-height } { \l__agl_stem_str }
                {
                  \fp_eval:n
                    {
                      round ( \dim_to_decimal_in_unit:nn
                        { \box_ht:N \l__agl_block_box + \box_dp:N \l__agl_block_box } { 1 mm } , 1 )
                    }
                }
                { \fp_eval:n { round ( \dim_to_decimal_in_unit:nn { \textheight } { 1 mm } , 1 ) } }
            }
        }
        {
          \vbox_set_to_ht:Nnn \l__agl_block_box { ( \textheight - \c__agl_atlasgap_dim ) / 2 }
            { \box_use_drop:N \l__agl_block_box \tex_vss:D }
        }
      \addvspace { \c__agl_atlasgap_dim }
      \nointerlineskip
      \box_use_drop:N \l__agl_block_box
    \group_end:
    \par
  }
\str_const:Nn \c__agl_here_str { . }
\NewDocumentCommand \sidecarfigure { O{htbp} m }
