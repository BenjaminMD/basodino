  \ifoot*{}}

% -------------------------------------------------------------- title page
\newcommand*\agl@label[1]{%
  {\sffamily\bfseries\scriptsize\color{glacier}\addfontfeature{LetterSpace=9}\MakeUppercase{#1}}}
\newcommand*\agl@hero{}
\NewDocumentCommand\herofigure{m m m}{\def\agl@hero{\agl@herobox{#1}{#2}{#3}}}
\newcommand\agl@herobox[3]{%
  \makebox[\textwidth][c]{\includegraphics[width=\paperwidth,height=88mm,keepaspectratio]{#1}}\par
  \credit{#3}%
  {\sffamily\small\color{rock}#2\par}}
% contents on the title page; tocbasic resets the page-number font to
% \normalfont\normalsize, so family and size are set here
\newcommand*\agl@tocpage[2]{{\sffamily\footnotesize\color{#1}#2}}
\DeclareTOCStyleEntry[
  beforeskip=.3em plus 1pt, indent=0pt, numwidth=1.6em,
  entryformat=\bfseries\color{ink}, entrynumberformat=\textcolor{glacier},
  pagenumberformat=\agl@tocpage{ink}, linefill=\hfill]{tocline}{section}
\DeclareTOCStyleEntry[
  level=1, beforeskip=0pt, indent=1.6em, numwidth=0pt,
  entryformat=\color{rock}, pagenumberformat=\agl@tocpage{rock},
  linefill=\hfill]{tocline}{question}
% PDF bookmarks: questions nested below their section (the contents list
% itself uses \questiontocdepth, set by level=1 above).
\AtBeginDocument{\def\toclevel@question{2}}
\setcounter{tocdepth}{1}
\renewcommand*\maketitle{%
  \thispagestyle{bare}\KOMAoptions{headsepline=false}% outside the group: the page ships after it
  \begingroup
  \setlength\parindent{0pt}%
  \sffamily
  \agl@label{Applied Glaciology\enskip\textperiodcentered\enskip Assignments part 1%
    \enskip\textperiodcentered\enskip Fall Semester 2026}\par
  \vspace{5mm}%
  {\fontsize{34}{38}\selectfont\bfseries\color{ink}\@title\par}%
  \ifx\@subtitle\@empty\else
    \vspace{3mm}%
    {\fontsize{15}{19}\fontseries{l}\selectfont\color{rock}\@subtitle\par}%
  \fi
  \vspace{9mm}%
  \agl@hero
  \vfill
  \begin{minipage}[t]{.38\textwidth}\raggedright
    \agl@label{Group}\par\vspace{2mm}%
    {\large\color{ink}\agl@namelist}%
    \vspace{5mm}%
    \agl@label{Submitted}\par\vspace{2mm}%
    {\color{ink}\@date\par ETH Zürich\par}%
  \end{minipage}\hfill
  \begin{minipage}[t]{.54\textwidth}
    \agl@label{Contents}\par\vspace{2mm}%
    % unnumbered entries align with the numbered titles, as in the body
    {\footnotesize\hypersetup{linkcolor=.}\renewcommand*\nonumberline{\numberline{}}%
     \listoftoc*{toc}}%
  \end{minipage}\par
  \endgroup
  \clearpage\KOMAoptions{headsepline=.4pt}}

% ------------------------------------------------------ figures and captions
\RequirePackage{graphicx}
\RequirePackage{tikz}
\usetikzlibrary{calc}
\RequirePackage{flafter}% a float never appears before the text that calls it
\RequirePackage{caption}
\RequirePackage{subcaption}
\captionsetup{format=hang, font={sf,small}, labelfont={bf,color=glacier}, labelsep=quad,
  justification=raggedright, singlelinecheck=false, skip=6pt}
\captionsetup[sub]{font={sf,footnotesize}, labelfont={bf,color=glacier},
  labelformat=parens, labelsep=space, skip=4pt}
\captionsetup[table]{position=top, skip=5pt}
\renewcommand*\topfraction{.9}
\renewcommand*\bottomfraction{.5}
\renewcommand*\textfraction{.1}
\renewcommand*\floatpagefraction{.8}
\setcounter{topnumber}{3}
\setcounter{totalnumber}{4}
% Figures and tables go where they are written if they fit (then top of a
% later page, never before the calling text: flafter). Pages of floats only
% are filled from the top, like the plates and the atlas.
\def\fps@figure{htbp}
\def\fps@table{htbp}
\setlength\@fptop{0pt}
\setlength\@fpsep{1.5\baselineskip}
\setlength\@fpbot{0pt plus 1fil}
% Float content is centred; tables are set in Source Sans 3 with tabular
% figures, so digits line up. (Code must run inside the float box, after
% LaTeX resets the font there, hence \@floatboxreset.)
\def\agl@tablename{table}
\g@addto@macro\@floatboxreset{%
  \centering
  \ifx\@captype\agl@tablename\sffamily\small\addfontfeature{Numbers=Tabular}\fi}
% Source line under an image or table, right-aligned.
\newcommand*\credit[1]{%
  \par\nobreak\vspace{2pt}{\raggedleft\sffamily\scriptsize\color{rock}#1\par}}
% Figures and plates share the list of figures ("Figure A.1", "Plate 4b"),
% set like the contents: Source Sans 3, no dot leaders.
\newcommand*\agl@lofnumber[2]{\textcolor{rock}{#1~#2}}
\newcommand*\agl@lofpage[1]{{\sffamily\small\color{rock}#1}}
\DeclareTOCStyleEntry[level=1, indent=0pt, numwidth=5.6em, beforeskip=.2em plus 1pt,
  entryformat=\sffamily\small, pagenumberformat=\agl@lofpage, linefill=\hfill,
  entrynumberformat=\agl@lofnumber{\figurename}]{tocline}{figure}
\DeclareTOCStyleEntry[level=1, indent=0pt, numwidth=5.6em, beforeskip=.2em plus 1pt,
  entryformat=\sffamily\small, pagenumberformat=\agl@lofpage, linefill=\hfill,
  entrynumberformat=\agl@lofnumber{\platename}]{tocline}{plate}
\BeforeStartingTOC[lof]{\hypersetup{linkcolor=.}}% text colour, as in the contents
\AtBeginDocument{\renewcaptionname{british}{\listfigurename}{Figures and plates}}

% ------------------------------------------ sidecar text: plates and figures
% Figures and plates hold graphics only. Their text lives in sidecar files
% next to the graphic and is set here (interface: SIDECARS.md):
%   <stem>.caption.tex  \renewcommand\FigTitle{..} \FigText{..} \FigCredits{..}
%   <stem>.table.tex    optional: one tabular* of width \linewidth
% A name without a slash is looked up in \platedir or \atlasdir; its label
% is the name (\cref{plate3_ortho}, \cref{elevation_glacier}).
%
% Plate page (landscape, plate area 273 x 175 mm): <id>_map.pdf, 175 x 175 mm,
% at 100 % on the left; a 6 mm gutter; a 92 mm sidebar with <id>_legend.pdf
% (92 mm wide, at most 105 mm high) at the top, then "Plate n", \FigTitle,
% \FigText and the table, and \FigCredits at the foot, its last baseline on
% the bottom edge of the map. The plate number comes from the id
% (plate4b_sentinel is Plate 4b). A plate ends the current page.
\newcommand\FigTitle{}
\newcommand\FigText{}
\newcommand\FigCredits{}
\newcounter{plate}
\newcommand*\platename{Plate}
\newcommand*\agl@rag{% ragged right with a soft rag: lines may hyphenate
  \setlength\leftskip{0pt}\setlength\rightskip{0pt plus 2.5em}%
  \setlength\parfillskip{0pt plus 1fil}\setlength\parindent{0pt}}
\newcommand*\agl@platehead{% "Plate 1" and the title
  {\agl@rag\sffamily\bfseries\small\color{glacier}\platename~\theplate\par}%
  {\agl@rag\sffamily\bfseries\fontsize{14}{17}\selectfont\color{ink}\FigTitle\par}}
\newcommand*\agl@platetext{%
  \vspace{3.5mm}%
  {\agl@rag\sffamily\small\color{text}\FigText\par}}
\newcommand*\agl@credits{% plates: foot of the sidebar; figures: after the caption
  {\agl@rag\sffamily\scriptsize\color{rock}\FigCredits\par}}
% Tables that belong to a figure or plate: 92 mm wide (the plate sidebar;
% under a figure aligned with the caption text), 8 pt Source Sans 3 with
% tabular figures.
\newcommand*\agl@tablefont{%
  \sffamily\scriptsize\addfontfeature{Numbers=Tabular}\color{text}%
  \setlength\tabcolsep{4pt}%
  % booktabs rules and gaps in proportion to the 8 pt type (booktabs fixes
  % them at load time from the 11 pt text: 0.88 pt rules would look heavy)
  \setlength\heavyrulewidth{.08em}\setlength\lightrulewidth{.05em}%
  \setlength\cmidrulewidth{.03em}%
  \setlength\aboverulesep{.4ex}\setlength\belowrulesep{.65ex}}
\ExplSyntaxOn
\str_new:N \g__agl_platedir_str
\str_new:N \g__agl_atlasdir_str
\cs_new_protected:Npn \__agl_setdir:Nn #1#2
  {
    \str_gset:Nn #1 {#2}
    \str_if_eq:eeT { \str_item:Nn #1 { -1 } } { / }
      { \str_gset:Ne #1 { \str_range:Nnn #1 { 1 } { -2 } } }
  }
\NewDocumentCommand \platedir { m } { \__agl_setdir:Nn \g__agl_platedir_str {#1} }
\NewDocumentCommand \atlasdir { m } { \__agl_setdir:Nn \g__agl_atlasdir_str {#1} }
\platedir { ../maps/plates/out }
\atlasdir { ../maps/figures_v2 }
% High-resolution build (plates_atlas.tex): <stem>_map_<version>.pdf and
% <stem>_legend_<version>.pdf replace the report files where they exist.
\str_new:N \g__agl_version_str
\NewDocumentCommand \plateversion { m } { \str_gset:Nn \g__agl_version_str {#1} }
\dim_const:Nn \c__agl_map_dim { 175mm }
\dim_const:Nn \c__agl_side_dim { 92mm }
\dim_const:Nn \c__agl_legend_dim { 105mm }
\dim_const:Nn \c__agl_gutter_dim { 6mm }
\dim_const:Nn \c__agl_legendgap_dim { 8mm }
