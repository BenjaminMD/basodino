% Pale ice field with contour rings, file name and target size in the middle.
\newcommand\agl@drawplaceholder[4]{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (#1,#2);
    \fill[ice] (0,0) rectangle (#1,#2);
    \begin{scope}
      \clip (0,0) rectangle (#1,#2);
      \foreach \k in {1,...,14}
        \draw[glacier!16, line width=.5pt] (.64*#1,.60*#2) ellipse ({\k*.075*#1} and {\k*.06*#1});
    \end{scope}
    \draw[glacier!45, line width=.5pt] (.25pt,.25pt) rectangle ($(#1,#2)-(.25pt,.25pt)$);
    \node[fill=ice, inner sep=3pt, align=center, text=glacier,
          font=\sffamily\footnotesize] at (.5*#1,.5*#2)
      {\texttt{\detokenize{#3}}\\[1pt]{\color{rock}\scriptsize #4\ \textperiodcentered\ missing}};
  \end{tikzpicture}}

% ---------------------------------------------------------- tables, units
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\newcolumntype{L}{>{\raggedright\arraybackslash}X}% ragged-right X column
% symbols: the variables of the equation above, one row each, not floating:
%   \begin{symbols} $x$ & meaning & value or unit \\ ... \end{symbols}
\NewDocumentEnvironment{symbols}{+b}
  {\par\nopagebreak\smallskip\noindent{\small\addfontfeature{Numbers=Tabular}
   \begin{tabularx}{\linewidth}{@{} l L l @{}}\toprule #1 \bottomrule\end{tabularx}}%
   \par\medskip}
  {}
\RequirePackage{siunitx}
% Numbers and units follow the surrounding font: serif in text, sans in
% tables and captions, math font in formulas.
\sisetup{
  mode = match, reset-text-family = false, reset-text-series = false,
  reset-text-shape = false,
  per-mode = power, inter-unit-product = \,, group-separator = {\,},
  list-units = single, range-units = single, product-units = single,
  uncertainty-mode = separate, retain-explicit-plus}% +0.23 m w.e. stays a gain
\DeclareSIUnit\annum{a}% per annum, as in m w.e. a^-1
\DeclareSIUnit\we{w.e.}% water equivalent
\DeclareSIUnit\mwe{\metre\we}% m w.e.
\DeclareSIUnit\mwea{\metre\we\per\annum}% m w.e. a^-1
\DeclareSIUnit\degreeday{(°C\,d)}% literal: siunitx cannot bracket a unit product
\DeclareSIUnit\ddf{\milli\metre\we\per\degreeday}% mm w.e. (°C d)^-1
\DeclareSIUnit\kmcubed{\cubic\kilo\metre}% km^3
\DeclareSIUnit\masl{m~a.s.l.}% metres above sea level

